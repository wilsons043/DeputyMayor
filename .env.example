# Optional: Gemini API key for Field Capture (get key at https://aistudio.google.com/app/apikey)
# VITE_GEMINI_API_KEY=your_key_here

# Optional: Google OAuth Client ID for Drive (Premium tier). Create at https://console.cloud.google.com/apis/credentials
# Use a "Web application" client and add your origin (e.g. http://localhost:5173) to authorized JavaScript origins.
# VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Optional: self-hosted geocoding and routing for the Mileage Tracker.
# Defaults are the public OpenStreetMap Nominatim and OSRM demo servers.
# VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
# VITE_OSRM_URL=https://router.project-osrm.org
